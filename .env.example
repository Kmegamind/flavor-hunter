# Server-side only. Never expose these in the client bundle.
# Enable Places API (New) + Geocoding API on this key (autocomplete, text search, reverse geocode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_PLACES_API_KEY=

# Browser Maps JavaScript API only (HTTP-referrer restricted).
# Do NOT reuse GOOGLE_PLACES_API_KEY here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Cloud-based Maps Styling Map ID from Google Cloud Console (Map Management).
NEXT_PUBLIC_GOOGLE_MAP_ID=
